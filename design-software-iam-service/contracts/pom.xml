<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>co.sena</groupId>
    <artifactId>iam-service</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>iam-contracts</artifactId>

  <!--
    Contract-first DTOs and API interfaces.

    Source of truth: design-software-shared-contracts (openapi/iam.yaml + openapi/_shared.yaml).
    The spec under openapi/ is a pinned vendored copy; see openapi/PINNED-FROM.md for the
    upstream commit. Nothing here is hand-written: everything under target/generated-sources
    is produced by openapi-generator at build time.
  -->

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-iam-api</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <!-- baseUri (not basedir): a bare Windows path is parsed as an opaque URI scheme -->
              <inputSpec>${project.baseUri}openapi/iam.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>co.sena.iam.contract.api</apiPackage>
              <modelPackage>co.sena.iam.contract.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
              <!--
                Keep the Java model names stable when OpenAPI Generator
                materializes these contract references as inline schemas.
                The API contract remains the source of truth; this only avoids
                generated names such as TokenResponseUser and
                ModuleFeaturesInner on a clean build.
              -->
              <inlineSchemaNameMappings>
                <inlineSchemaNameMapping>TokenResponse_user=AuthUser</inlineSchemaNameMapping>
                <inlineSchemaNameMapping>Module_features_inner=Feature</inlineSchemaNameMapping>
              </inlineSchemaNameMappings>
              <!--
                Naming note: the shared error envelope (_shared.yaml#/components/schemas/Error)
                arrives through an external $ref, so the generator names it after the first
                operation that returns it -> Login400Response / Login400ResponseError.
                The wire format is the contract's; only the Java name is awkward. It gets a
                readable alias in the REST adapter (ApiErrors).
              -->
              <configOptions>
                <useSpringBoot3>true</useSpringBoot3>
                <interfaceOnly>true</interfaceOnly>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
                <documentationProvider>none</documentationProvider>
                <annotationLibrary>none</annotationLibrary>
                <useOptional>false</useOptional>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
