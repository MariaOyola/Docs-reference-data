{
  "name": "@sena/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tokens y componentes visuales compartidos del frontend SENA.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./src/tokens/tokens.generated.css",
    "./components": "./src/components/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "sync:spec": "node scripts/generate-tokens.mjs --sync-spec",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check:no-hardcode": "node scripts/check-no-hardcode.mjs",
    "verify": "npm run check:tokens && npm run check:no-hardcode && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}